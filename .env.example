# Zen-Coder — copy to .env.local (never commit real secrets)

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
# AUTH_SECRET=   # openssl rand -base64 32  (required in production)

# --- Database (Turso / libSQL) ---
# Leave empty for local file DB if your db client supports it
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# --- AI providers (configure at least one) ---
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- GitHub App ---
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=

# --- Cron (required in production) ---
# CRON_SECRET=

# --- Stripe ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_PACK_10K=
# STRIPE_PRICE_PACK_50K=
